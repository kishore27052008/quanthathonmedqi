# App
APP_NAME=MedQ AI
ENV=development
SECRET_KEY=change_me_super_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
POSTGRES_USER=medq
POSTGRES_PASSWORD=medq_pass
POSTGRES_DB=medq_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medq:medq_pass@localhost:5432/medq_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# ML model store (path where trained .pkl / .json models live)
MODEL_STORE_PATH=./models_store

# Quantum
QUANTUM_BACKEND=default.qubit
